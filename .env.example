# Set these in Vercel (Production + Preview) -> Project Settings -> Environment Variables. Never commit real values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=      # server-side only (Vercel Functions); never in public/
ADMIN_PIN=                      # >= 6 chars (use 10+). Shared by admins only.
SESSION_SECRET=                 # >= 16 chars, random: openssl rand -hex 32
